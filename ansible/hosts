# ==============================================================================
# Ansible Inventory — Biblioteca API
# ==============================================================================
# Define os nós gerenciados da infraestrutura.
# VM2 é o nó gerenciado que executará a aplicação Biblioteca API.
# ==============================================================================

[webservers]
vm2 ansible_host=192.168.56.11 ansible_user=vagrant ansible_ssh_private_key_file=/home/vagrant/.ssh/id_rsa

[webservers:vars]
app_name=biblioteca-api
app_port=8080
app_repo_url=https://github.com/Vitorrevoredo/Biblioteca-API.git
app_dest_dir=/opt/biblioteca-api
app_user=vagrant
app_group=vagrant
node_version=20

[all:vars]
ansible_python_interpreter=/usr/bin/python3
